# Chave da API da Anthropic (console.anthropic.com) — usada pelo backend em backend/lib/claude.ts
ANTHROPIC_API_KEY=

# Token secreto que a extensão manda no header pra autenticar no /api/suggest e /api/call-ended
# Gere qualquer string aleatória longa (ex: openssl rand -hex 32)
COPILOTO_API_TOKEN=

# URL pública do backend depois de deployado na Vercel (ex: https://quebra-objecao.vercel.app)
# Usada pela task save-call-transcript se precisar chamar o backend de volta (opcional)
BACKEND_URL=

# Secret key do projeto Trigger.dev (cloud.trigger.dev → Project → API Keys)
# Necessária no backend pra disparar a task save-call-transcript via tasks.trigger()
TRIGGER_SECRET_KEY=
